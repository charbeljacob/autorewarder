cd ~/Desktop/autorewarder

# Create venv
python3 -m venv .venv

# Upgrade pip and install requirements
.venv/bin/python -m pip install --upgrade pip
.venv/bin/pip install -r requirements.txt

# Install PyGObject inside the venv so pywebview can find the GTK bindings
.venv/bin/pip install pycairo PyGObject

# Verify all imports
.venv/bin/python -c "import selenium, PIL, pystray, nlpaug, requests, gi; print('All deps OK')"
