# 1. Detect the installed Edge version
EDGE_VERSION=$(microsoft-edge --version | awk '{print $3}')
echo "Detected Edge version: $EDGE_VERSION"

# 2. Download the matching driver from the new domain
wget -O /tmp/edgedriver.zip "https://msedgedriver.microsoft.com/${EDGE_VERSION}/edgedriver_linux64.zip"

# 3. Extract and install the driver
sudo apt install -y unzip  # Ensure unzip is available
unzip -o /tmp/edgedriver.zip -d /tmp/msedgedriver/
sudo mv /tmp/msedgedriver/msedgedriver /usr/local/bin/
sudo chmod +x /usr/local/bin/msedgedriver
rm -rf /tmp/edgedriver.zip /tmp/msedgedriver/

# 4. Verify the installation
msedgedriver --version
